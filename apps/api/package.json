{
  "name": "@zentra/api",
  "version": "0.1.0",
  "private": true,
  "description": "ZENTRA — Central Backend API & Worker Foundation (NestJS + Fastify)",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "clean": "rimraf dist *.tsbuildinfo",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:rollback": "tsx src/database/cli.ts rollback",
    "db:status": "tsx src/database/cli.ts status"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@zentra/config": "workspace:*",
    "@zentra/contracts": "workspace:*",
    "@zentra/shared": "workspace:*",
    "@zentra/types": "workspace:*",
    "@zentra/validation": "workspace:*",
    "fastify": "^5.2.1",
    "kysely": "^0.27.4",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.11",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "@zentra/testing": "workspace:*",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
