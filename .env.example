# ==============================================================================
# ZENTRA — Environment Configuration Template
# ==============================================================================
# SAFE TEMPLATE ONLY — NEVER COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS
# Environments supported: LOCAL, TEST, DEVELOPMENT, STAGING, PRODUCTION
# Copy this file to .env.local for local development.
# ==============================================================================

# Runtime Environment
NODE_ENV=development
APP_ENV=local

# Central API Server (ZENTRA Core / apps/api)
API_PORT=4000
API_HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL 16+)
# Local default connects to Dockerized Postgres (infra/docker)
DATABASE_URL=postgresql://zentra_dev:zentra_dev_pass@localhost:5432/zentra_local
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Test Database Isolation (Used exclusively by vitest runner)
# FAIL-CLOSED GATE will abort if pointed to production or missing test marker
TEST_DATABASE_URL=postgresql://zentra_test:zentra_test_pass@localhost:5432/zentra_test

# S3 / Object Storage (MinIO for Local / AWS S3 or Cloudflare R2 for Cloud)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_NAME=zentra-local-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Background Worker & Job Daemon (PG-Boss in PostgreSQL)
PG_BOSS_WORKER_CONCURRENCY=5

# Cryptographic Token Secrets (Development Mock Keys — MUST BE ROTATED IN STAGING/PROD)
# Minimum 32-character high-entropy secret string required in production
JWT_ACCESS_SECRET=local_development_jwt_access_secret_32chars_min!
JWT_REFRESH_SECRET=local_development_jwt_refresh_secret_32chars_min!
OFFLINE_PERMIT_SIGNING_KEY=local_development_offline_permit_key_32chars!

# Observability & Logging
LOG_LEVEL=debug
PRETTY_LOGGING=true

# Web Portal Client (apps/web)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_ENV=local

# Mobile Field Client (apps/field)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_APP_ENV=local
