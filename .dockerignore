# ==============================================================================
# ZENTRA — Docker Build Context Exclusion File (.dockerignore)
# Stage 8: Production Containerization
# ==============================================================================

# Version Control & IDE Metadata
.git
.gitignore
.gitattributes
.github
.vscode
.idea

# Package Managers, Local Dependencies & Caches
node_modules/
**/node_modules/
.pnpm-store/
.turbo/
**/.turbo/
*.tsbuildinfo
.cache/

# Build Outputs & Transpilation Artifacts
dist/
**/dist/
build/
**/build/
out/
coverage/

# Mobile Native Workspace (Excluded from API container)
apps/field/
*.keystore
*.jks
.expo/

# Web Portal Frontend Workspace (Excluded from API container)
apps/web/

# Local Verification Artifacts & Test Databases
artifacts/
scratch/
*.png
*.sqlite
*.db
*.db-shm
*.db-wal

# Cryptographic Keys & Secrets (CRITICAL SECURITY ISOLATION)
.env
.env.*
!*.env.example
*.pem
*.key
*.cert
*.crt
*.pfx

# System & Infrastructure Configurations
infra/
terraform/
docs/
*.md
!README.md
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
